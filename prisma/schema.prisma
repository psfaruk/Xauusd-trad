// binaryTargets — Railway deploy crash fix (v15.1):
// `prisma generate` runs under BUN in the Docker builder, and Bun reports
// its own linked OpenSSL (1.1.x) → "native" resolved to
// debian-openssl-1.1.x. At runtime the client detects the SYSTEM libssl
// (debian-openssl-3.0.x on bookworm) → "Query Engine not found" →
// PrismaClientInitializationError on every DB call. Ship every Debian
// engine so whichever side the detection lands on, the .so is there.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// User-created chart drawings, persisted per symbol + timeframe.
model Drawing {
  id        String   @id @default(uuid())
  symbol    String
  timeframe String
  kind      String // trendline | ray | hline | vline | rect | fib | text | measure
  points    String // JSON [{t,p}]
  style     String // JSON {color?, width?, text?}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol, timeframe])
}

/// Every signal the engine fires — full history for the Signals panel.
model SignalRecord {
  id         String    @id @default(uuid())
  symbol     String
  timeframe  String
  direction  String // BUY | SELL
  trigger    String // sfp | zone | pullback
  entryType  String // market | limit
  entry      Float
  sl         Float
  tp         Float
  rr         Float
  confidence Float
  status     String // active | pending | won | lost | expired
  resultR    Float?
  trace      String // JSON: checks + factors
  barTime    Int
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  @@unique([symbol, timeframe, barTime, direction])
  @@index([symbol, createdAt])
}

/// Pinned watchlist symbols (order survives restarts / deploys).
model WatchItem {
  id        String  @id @default(uuid())
  symbol    String  @unique
  label     String
  sortOrder Int     @default(0)
}

/// Generic key/value app settings (locale, theme, defaults).
model AppSetting {
  key   String @id
  value String
}

/// v21.0 — one row per AI Board meeting (6-agent roundtable decision).
model BoardSession {
  id        String   @id @default(uuid())
  symbol    String
  timeframe String
  action    String // BUY | SELL | HOLD
  entry     Float?
  sl        Float?
  tp        Float?
  tp2       Float?
  rr        Float?
  lot       Float?
  consensus Int      @default(0) // 0..100
  agents    String // JSON: the 6 agent outputs (votes, notes, confidence)
  drawings  String // JSON: deterministic chart geometry (OB box, trendline)
  context   String // JSON: the market snapshot the board saw
  barTime   Int
  status    String   @default("open") // open | won | lost | expired
  resultPct Float? // close-to-close outcome %, set when resolved
  degraded  Boolean  @default(false) // LLM unavailable → local fallback
  createdAt DateTime @default(now())
  closedAt  DateTime?

  @@index([symbol, timeframe, createdAt])
}
