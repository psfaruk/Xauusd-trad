# v15.1 CRITICAL: the site address is ":{$PORT}" — WITH the leading colon.
# The old "{$PORT}" expanded to a bare token like "8080", which Caddy
# parsed as a DOMAIN NAME: it tried to issue a public ACME certificate
# for the literal domain "8080" (failing forever: "could not get
# certificate from issuer") and bound :80/:443 instead of $PORT — so the
# Railway healthcheck and the generated domain had no listener at all.
# ":{$PORT}" binds exactly $PORT, plain HTTP, no ACME, no auto-HTTPS.
:{$PORT} {
        # ══════════════════════════════════════════════════════════════════
        # v14 SECURITY: the public door is now SINGLE-PURPOSE.
        #   ?XTransformPort=3030 → mt5-service socket.io (live ticks/bars/flow)
        # Everything else → the Next.js app. The mt5-service REST (:3031)
        # is NO LONGER reachable from the internet at all — the app's own
        # browser reaches it exclusively through the Next.js same-origin
        # proxy /api/mt5/* (localhost:3031 + x-trader-key server-side).
        # The service additionally guards every market endpoint with the
        # session/key (defense in depth); only /health stays open (local).
        # ══════════════════════════════════════════════════════════════════

        @io_port query XTransformPort=3030
        handle @io_port {
                reverse_proxy localhost:3030 {
                        header_up Host {host}
                        header_up X-Real-IP {remote_host}
                }
        }

        # any OTHER XTransformPort value (or none) → the Next.js app only
        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Real-IP {remote_host}
                }
        }
}
